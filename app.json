
{
  "expo": {
    "name": "SquadUp",
    "slug": "squadup",
    "scheme": "squadup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/squadupsicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/squadupsicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.farizdanialris.squadupapp"
    },
    "web": {
      "favicon": "./assets/squadupsicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-router",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7ffd953-1f67-435c-9f97-bdedec327b94"
      }
    },
    "owner": "farizdanialris"
  }
}
